# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다(.gitignore).
# application.properties 의 spring.config.import 가 .env 를 읽는다.

# DB (local 프로필: DB_PASSWORD 만 사용 / prod 프로필: 셋 다 사용)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키 (32바이트 이상 무작위 값)
JWT_SECRET=
# JWT_ACCESS_EXP_MIN=60
# JWT_REFRESH_EXP_DAYS=14

OPENAI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# S3 (storage.type=s3 일 때)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
